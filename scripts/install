#!/bin/bash
source "${0%/*}/_common.sh"
source /usr/share/yunohost/helpers

# ── Copiar fuentes ─────────────────────────────────────────
cp -r ../sources/dist "$install_dir/dist"
cp -r ../backend      "$install_dir/backend"
chown -R "$app:www-data" "$install_dir"
chmod -R o-rwx "$install_dir"

# ── Crear virtualenv e instalar dependencias Python ────────
python3 -m venv "$install_dir/venv"
"$install_dir/venv/bin/pip" install --quiet --upgrade pip
"$install_dir/venv/bin/pip" install --quiet -r "$install_dir/backend/requirements.txt"

# ── Directorio de logs ────────────────────────────────────
mkdir -p "/var/log/$app"
chown "$app:www-data" "/var/log/$app"

# ── Nginx ─────────────────────────────────────────────────
ynh_config_add_nginx

# ── Systemd ───────────────────────────────────────────────
ynh_config_add_systemd
yunohost service add "$app" --description="Agenda Productiva" --log="/var/log/$app/$app.log"
ynh_systemd_action --service_name="$app" --action="start" --log_path="/var/log/$app/$app.log"

# ── Logrotate ─────────────────────────────────────────────
ynh_config_add_logrotate

# ── Icono portal (SSOwat ≤11 y YunoHost 12+) ─────────────
for _icon_dir in \
    /usr/share/yunohost/portal/assets/apps \
    /usr/share/ssowat/portal/assets/icons; do
    mkdir -p "$_icon_dir"
    install -m 644 ../logo.png "$_icon_dir/$app.png"
done
