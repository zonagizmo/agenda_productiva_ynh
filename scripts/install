#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

# Sustituye los placeholders __VAR__ en un fichero
_apply_template() {
    sed -i \
        -e "s|__APP__|$app|g" \
        -e "s|__INSTALL_DIR__|$install_dir|g" \
        -e "s|__DATA_DIR__|$data_dir|g" \
        -e "s|__PORT__|$port|g" \
        -e "s|__PATH__|$path|g" \
        -e "s|__DOMAIN__|$domain|g" \
        "$1"
}

# ── Copiar fuentes ─────────────────────────────────────────
cp -r ../sources/. "$install_dir/"
chown -R "$app:www-data" "$install_dir"
chmod -R o-rwx "$install_dir"

# ── Crear virtualenv e instalar dependencias ───────────────
python3 -m venv "$install_dir/venv"
"$install_dir/venv/bin/pip" install --quiet --upgrade pip
"$install_dir/venv/bin/pip" install --quiet -r "$install_dir/requirements.txt"

# ── Systemd ────────────────────────────────────────────────
install -m 644 ../conf/systemd.service /etc/systemd/system/"$app".service
_apply_template /etc/systemd/system/"$app".service
systemctl daemon-reload
systemctl enable "$app" --quiet
systemctl start "$app"
yunohost service add "$app" --description="Agenda Productiva" --log="/var/log/$app/$app.log"

# ── Nginx ──────────────────────────────────────────────────
mkdir -p /etc/nginx/conf.d/"$domain".d
install -m 644 ../conf/nginx.conf /etc/nginx/conf.d/"$domain".d/"$app".conf
_apply_template /etc/nginx/conf.d/"$domain".d/"$app".conf
nginx -t && systemctl reload nginx

# ── Icono portal SSOwat ────────────────────────────────────
mkdir -p /usr/share/ssowat/portal/assets/icons
install -m 644 ../logo.png /usr/share/ssowat/portal/assets/icons/"$app".png
