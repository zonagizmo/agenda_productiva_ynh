#!/bin/bash
source "${0%/*}/_common.sh"
source /usr/share/yunohost/helpers

# ── Copiar fuentes ─────────────────────────────────────────
cp -r ../sources/dist "$install_dir/dist"
cp -r ../backend      "$install_dir/backend"
chown -R "$app:www-data" "$install_dir"
chmod -R o-rwx "$install_dir"

# ── Crear virtualenv e instalar dependencias Python ────────
python3 -m venv "$install_dir/venv"
"$install_dir/venv/bin/pip" install --quiet --upgrade pip
"$install_dir/venv/bin/pip" install --quiet -r "$install_dir/backend/requirements.txt"

# ── Verificar que el backend importa correctamente ────────
"$install_dir/venv/bin/python" -c "import sys; sys.path.insert(0,'$install_dir/backend'); from app.main import app" \
  || ynh_die "El backend no arranca tras la instalación — revisa los logs"

# ── Directorio de logs ────────────────────────────────────
mkdir -p "/var/log/$app"
chown "$app:www-data" "/var/log/$app"

# ── Nginx ─────────────────────────────────────────────────
mkdir -p /etc/nginx/conf.d/"$domain".d
install -m 644 ../conf/nginx.conf /etc/nginx/conf.d/"$domain".d/"$app".conf
sed -i -e "s|__APP__|$app|g" -e "s|__INSTALL_DIR__|$install_dir|g" \
       -e "s|__PORT__|$port|g" -e "s|__PATH__|$path|g" -e "s|__DOMAIN__|$domain|g" \
       /etc/nginx/conf.d/"$domain".d/"$app".conf
nginx -t && systemctl reload nginx

# ── Systemd ───────────────────────────────────────────────
install -m 644 ../conf/systemd.service /etc/systemd/system/"$app".service
sed -i -e "s|__APP__|$app|g" -e "s|__INSTALL_DIR__|$install_dir|g" \
       -e "s|__DATA_DIR__|$data_dir|g" -e "s|__PORT__|$port|g" -e "s|__PATH__|$path|g" \
       /etc/systemd/system/"$app".service
systemctl daemon-reload
systemctl enable "$app" --quiet
systemctl start "$app"
yunohost service add "$app" --description="Agenda Productiva" --log="/var/log/$app/$app.log"

# ── Logrotate ─────────────────────────────────────────────
install -m 644 ../conf/logrotate /etc/logrotate.d/"$app"
sed -i "s|__APP__|$app|g" /etc/logrotate.d/"$app"

# ── Icono portal ──────────────────────────────────────────
# YunoHost 12.1+: applogos/   YunoHost 12.0: portal/assets/apps/   SSOwat ≤11: ssowat/icons/
for _icon_dir in \
    /usr/share/yunohost/applogos \
    /usr/share/yunohost/portal/assets/apps \
    /usr/share/ssowat/portal/assets/icons; do
    mkdir -p "$_icon_dir"
    install -m 644 ../logo.png "$_icon_dir/$app.png"
done
