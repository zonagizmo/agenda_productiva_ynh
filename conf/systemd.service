[Unit]
Description=Agenda Productiva
After=network.target

[Service]
Type=simple
User=__APP__
Group=www-data
WorkingDirectory=__INSTALL_DIR__
Environment="AGENDA_DATA_DIR=__DATA_DIR__"
Environment="APP_PATH=__PATH__"
ExecStart=__INSTALL_DIR__/venv/bin/python -m waitress --host=127.0.0.1 --port=__PORT__ app:app
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=__APP__

[Install]
WantedBy=multi-user.target
