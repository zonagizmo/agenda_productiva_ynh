<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Header -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agenda"
        android:textColor="#EEEEFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9999CC"
        android:textSize="10sp"
        android:layout_marginBottom="4dp" />

    <!-- Divider (ImageView is guaranteed supported in RemoteViews) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3A3A6A"
        android:layout_marginBottom="4dp"
        android:contentDescription="" />

    <!-- Item slots (5 max) -->
    <TextView android:id="@+id/widget_item0"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#EEEEFF" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"
        android:visibility="gone" android:layout_marginBottom="2dp" />
    <TextView android:id="@+id/widget_item1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#EEEEFF" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"
        android:visibility="gone" android:layout_marginBottom="2dp" />
    <TextView android:id="@+id/widget_item2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#EEEEFF" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"
        android:visibility="gone" android:layout_marginBottom="2dp" />
    <TextView android:id="@+id/widget_item3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#EEEEFF" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"
        android:visibility="gone" android:layout_marginBottom="2dp" />
    <TextView android:id="@+id/widget_item4"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#EEEEFF" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"
        android:visibility="gone" android:layout_marginBottom="2dp" />

    <!-- More / empty -->
    <TextView android:id="@+id/widget_more"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#7777AA" android:textSize="10sp"
        android:visibility="gone" android:layout_marginBottom="2dp" />
    <TextView android:id="@+id/widget_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Abre la app para cargar datos"
        android:textColor="#7777AA" android:textSize="10sp"
        android:visibility="visible" />

</LinearLayout>
